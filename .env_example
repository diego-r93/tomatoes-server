# Copy this file to .env and replace every CHANGE_ME value before starting.
# Keep .env private. Only this example belongs in Git.
# Generate each password, JWT secret, or token separately: openssl rand -hex 32

# MongoDB credentials used by Compose.
# The backend currently uses root; no app-user initialization script exists.
MONGO_ROOT_USERNAME=CHANGE_ME_MONGO_USER
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGO_INITDB_DATABASE=tomatoes-database

# Keep these aliases: the current MongoDB healthcheck uses these names.
MONGO_INITDB_ROOT_USERNAME=${MONGO_ROOT_USERNAME}
MONGO_INITDB_ROOT_PASSWORD=${MONGO_ROOT_PASSWORD}

# Backend connection inside the Compose network.
# Use a hexadecimal password to avoid URL-encoding issues.
MONGODB_URI="mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017/${MONGO_INITDB_DATABASE}?authSource=admin"

# Mongo Express web login. Use credentials different from MongoDB.
ME_BASIC_USER=CHANGE_ME_MONGO_EXPRESS_USER
ME_BASIC_PASS=CHANGE_ME_MONGO_EXPRESS_PASSWORD

# Backend MQTT connection inside the Compose network.
# Telegraf has a separate broker address in telegraf/telegraf.conf.
# Review that address before deploying to another network.
MQTT_HOST_NAME=mqtt://mosquitto:1883
MQTT_USER_NAME=CHANGE_ME_MQTT_USER
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# Backend listener. Keep port 3333 aligned with nginx/nginx.conf.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3333
JWT_SECRET=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_SECRET

# First-install InfluxDB setup. These values do not update an existing database.
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=CHANGE_ME_INFLUXDB_USER
# InfluxDB requires a password of at least 8 characters.
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME_INFLUXDB_PASSWORD
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_GENERATE_A_UNIQUE_INFLUXDB_TOKEN
DOCKER_INFLUXDB_INIT_ORG=tomatoes
DOCKER_INFLUXDB_INIT_BUCKET=tomatoes

# Initial retention: 180 days (six 30-day months).
# Update existing buckets through the InfluxDB API or CLI.
DOCKER_INFLUXDB_INIT_RETENTION=4320h

# Internal service name and port. Keep 8086 aligned with telegraf.conf.
DOCKER_INFLUXDB_INIT_PORT=8086
DOCKER_INFLUXDB_INIT_HOST=influxdb

# Host path relative to docker-compose.yml.
TELEGRAF_CFG_PATH=./telegraf/telegraf.conf
# User sessions and invitation links.
APP_PUBLIC_URL=http://192.168.1.30
AUTH_SESSION_HOURS=12
INVITE_EXPIRY_DAYS=7

# Personal Outlook/Hotmail sender. Authorize the account with OAuth2 first.
# Invitations remain unavailable until the sender and OAuth values are filled.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_AUTH_TYPE=oauth2
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_OAUTH_TOKEN_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/token

# Backend alert evaluation. Rules are created in the Alerting page; none are seeded.
ALERTING_ENABLED=true

# Optional official WhatsApp Cloud API. Leave disabled until Meta setup is complete.
# Select a supported Graph API version from your Meta app (for example, vXX.X).
# Never commit the real token. The approved message template is selected per contact point.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Optional OTA master key. Use 64 lowercase hex characters from board provisioning.
OTA_MASTER_KEY=
