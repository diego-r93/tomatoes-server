# SQLite journal files may contain private account data.
*.db-wal
*.db-shm
/backend/.sqlite-backups/

# Backend-only credentials
/backend/.env

# Mosquitto provisioning state
/mosquitto/config/acl
/mosquitto/config/.provision.lock
/mosquitto/config/.passwd.*
/mosquitto/config/.acl.*

# Generated Telegraf-only MQTT credentials
/telegraf/.mqtt.env
/telegraf/..mqtt.env.*

# Local MQTT TLS material and listener configuration
/mosquitto/config/.tls-stage.*/
/mosquitto/config/tls/
/mosquitto/config/listeners/*.conf

# Local web CA and HTTPS certificate material
/nginx/web-ca/
/nginx/tls/

# Python collector caches
__pycache__/
*.py[cod]

# Private ACME accounts, renewal state and logs
/nginx/acme/
