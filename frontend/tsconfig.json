{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] },
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/components/alert/*.vue", "src/components/device/DeviceCard.vue", "src/components/device/DeviceDetails.vue", "src/components/device/PumpHistoryDialog.vue"]
}
