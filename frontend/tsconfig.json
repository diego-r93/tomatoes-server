{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/components/alert/*.vue", "src/components/database/*.vue", "src/components/configuration/*.vue", "src/components/auth/SignIn.vue", "src/components/users/UserActivityHistory.vue", "src/components/help/HelpMenu.vue", "src/components/dashboard/Chart.vue", "src/components/dashboard/GaugeChart.vue", "src/components/dashboard/StatChart.vue", "src/components/dashboard/PanelVisualization.vue", "src/components/device/DeviceCard.vue", "src/components/device/DeviceDetails.vue", "src/components/device/PumpHistoryDialog.vue"]
}
